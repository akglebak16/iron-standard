extends SceneTree
const GearCatalog = preload("res://battle/data/gear_catalog.gd")
const HeroGear = preload("res://battle/data/hero_gear.gd")
const Catalog = preload("res://battle/data/catalog.gd")
const Factory = preload("res://battle/application/factory.gd")
const Setup = preload("res://battle/data/battle_setup.gd")

func _initialize() -> void:
	var catalog := GearCatalog.new()
	assert(catalog.load_data())
	var legacy := {"armor": 2, "weapon": 1, "shield": 2, "horse": 1}
	var before: Dictionary = legacy.duplicate(true)
	var gear: Dictionary = HeroGear.resolve(legacy, catalog)
	assert(legacy == before)
	assert(gear.slots.head == "head_cap")
	assert(gear.slots.body == "body_scale")
	assert(gear.weapon.id == "sword_knight")
	assert(gear.shield.id == "shield_heraldic")
	assert(gear.horse.id == "horse_riding")
	assert(gear.mounted)
	assert(gear.armor == 49.0) # head 3 + body 46
	assert(gear.block == 0.84)
	var defaults: Dictionary = HeroGear.resolve({}, catalog)
	assert(defaults.slots.body == "" and defaults.slots.shield == "")
	assert(defaults.weapon.id == "sword_old")
	var modern := {"eq": {"head": "head_great", "body": "body_plate", "melee": "tw_hammer", "ranged": "jav_heavy", "shield": "shield_heraldic", "horse": "horse_war"}, "sel": "melee"}
	var heavy: Dictionary = HeroGear.resolve(modern, catalog)
	assert(heavy.weapon.id == "tw_hammer")
	assert(heavy.shield.is_empty())
	assert(heavy.block == 0.32)
	assert(heavy.armor == 77.0)
	modern.sel = "ranged"
	var thrown: Dictionary = HeroGear.resolve(modern, catalog)
	assert(thrown.weapon.id == "jav_heavy")
	assert(thrown.shield.id == "shield_heraldic")
	assert(thrown.block == 0.84)
	thrown.weapon.dmg = 999
	assert(catalog.get_item("jav_heavy").dmg == 50)
	assert(modern.eq.ranged == "jav_heavy")
	var unarmed: Dictionary = HeroGear.resolve({"eq": {"melee": "missing"}}, catalog)
	assert(unarmed.weapon.id == "fist")
	assert(unarmed.block == 0.1)
	assert(HeroGear.resolve({"eq": "broken"}, catalog).is_empty())
	_test_factory(catalog)
	print("Hero gear tests passed")
	quit(0)

func _test_factory(gear_catalog: GearCatalog) -> void:
	var troops := Catalog.new()
	assert(troops.load_data())
	var setup: Setup = load("res://battle/data/demo_battle.tres").duplicate(true)
	setup.hero_profile = {"str": 3, "agi": 2, "vit": 4, "hp": 0.5, "eq": {"head": "head_cap", "body": "body_mail", "melee": "sword_knight", "ranged": "jav_heavy", "shield": "shield_plank", "horse": "horse_riding"}, "sel": "ranged"}
	var session = Factory.create(setup, troops, gear_catalog)
	assert(session != null)
	var hero = session._hero
	assert(hero.max_hp == 156.0)
	assert(hero.hp == 78.0)
	assert(hero.armor == 33.0)
	assert(hero.mounted and hero.speed == 150.0)
	assert(hero.damage == 56.0)
	assert(is_equal_approx(hero.attack_interval, 1.52))
	assert(hero.attack_range == 480.0)
	assert(hero.block_chance == 0.5)
	assert(hero.shield_block == 0.12)
	assert(hero.weapon_kind == "throw" and hero.damage_type == "pierce")
	assert(hero.pierce == 0.1)
	assert(is_equal_approx(hero.accuracy, 0.081))
	setup.hero_profile.eq.ranged = "missing"
	assert(hero.weapon_kind == "throw")
	assert(Factory.create(setup, troops) == null)
