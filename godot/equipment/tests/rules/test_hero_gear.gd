extends SceneTree
const ContentLoader = preload("res://adapters/content/catalog_loader.gd")
const GearCatalog = preload("res://equipment/data/gear_catalog.gd")
const HeroGear = preload("res://equipment/rules/hero_gear.gd")

func _initialize() -> void:
	var catalog := GearCatalog.new()
	assert(ContentLoader.populate(catalog))
	var legacy := {"armor": 2, "weapon": 1, "shield": 2, "horse": 1}
	var before: Dictionary = legacy.duplicate(true)
	var gear: Dictionary = HeroGear.resolve(legacy, catalog)
	assert(legacy == before)
	assert(gear.slots.head == "head_cap")
	assert(gear.slots.body == "body_scale")
	assert(gear.weapon.id == "sword_knight")
	assert(gear.shield.id == "shield_heraldic")
	assert(gear.horse.id == "horse_riding")
	assert(gear.mounted)
	assert(gear.armor == 49.0)
	assert(gear.block == 0.84)
	var defaults: Dictionary = HeroGear.resolve({}, catalog)
	assert(defaults.slots.body == "" and defaults.slots.shield == "")
	assert(defaults.weapon.id == "sword_old")
	var modern := {"eq": {"head": "head_great", "body": "body_plate", "melee": "tw_hammer", "ranged": "jav_heavy", "shield": "shield_heraldic", "horse": "horse_war"}, "sel": "melee"}
	var heavy: Dictionary = HeroGear.resolve(modern, catalog)
	assert(heavy.weapon.id == "tw_hammer")
	assert(heavy.shield.is_empty())
	assert(heavy.block == 0.32)
	assert(heavy.armor == 77.0)
	modern.sel = "ranged"
	var thrown: Dictionary = HeroGear.resolve(modern, catalog)
	assert(thrown.weapon.id == "jav_heavy")
	assert(thrown.shield.id == "shield_heraldic")
	assert(thrown.block == 0.84)
	thrown.weapon.dmg = 999
	assert(catalog.get_item("jav_heavy").dmg == 50)
	assert(modern.eq.ranged == "jav_heavy")
	var unarmed: Dictionary = HeroGear.resolve({"eq": {"melee": "missing"}}, catalog)
	assert(unarmed.weapon.id == "fist")
	assert(unarmed.block == 0.1)
	assert(HeroGear.resolve({"eq": "broken"}, catalog).is_empty())
	print("Hero gear tests passed")
	quit(0)
