config_version=5

[application]
config/name="Железный Стяг"
run/main_scene="res://apps/godot/composition/game.tscn"

[autoload]
GameTheme="*res://apps/godot/composition/theme_bootstrap.gd"

[display]
window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1366
window/size/window_height_override=768

[gui]
theme/custom="res://apps/godot/visuals/project_theme.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
